{
  "expo": {
    "name": "Ishta",
    "slug": "ishta",
    "scheme": "ishta",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/ishta-logo.png",
    "splash": {
      "image": "./assets/ishta-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#7A1F2B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ishta.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Ishta uses your camera so a priest can appear on video during a live pooja.",
        "NSMicrophoneUsageDescription": "Ishta uses your microphone so you can speak and hear during a live pooja."
      }
    },
    "android": {
      "package": "com.ishta.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/ishta-logo.png",
        "backgroundColor": "#7A1F2B"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/ishta-logo.png"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000/api/v1"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": { "minSdkVersion": 24 },
          "ios": { "deploymentTarget": "13.4" }
        }
      ]
    ]
  }
}
