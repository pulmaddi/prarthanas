{
  "expo": {
    "name": "Prarthanas",
    "slug": "prarthanas",
    "scheme": "prarthanas",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prarthanas.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Prarthanas uses your camera so a priest can appear on video during a live pooja.",
        "NSMicrophoneUsageDescription": "Prarthanas uses your microphone so you can speak and hear during a live pooja."
      }
    },
    "android": {
      "package": "com.prarthanas.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000/api/v1",
      "eas": {
        "projectId": "2e9328de-b712-4363-ad53-dcfc3bce854a"
      }
    },
    "plugins": [
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "13.4"
          }
        }
      ]
    ],
    "owner": "quaitech"
  }
}
